{
    "routes": [
        {
            "method": "GET",
            "path": "/api/v1/orgs/{orgId}/sites",
            "file": "sites.json",
            "params": {
                "orgId": {"in": "path", "type": "string", "required": true}
            }
        },
        {
            "method": "GET",
            "path": "/api/v1/sites/{siteId}/devices",
            "file": "devices.json",
            "params": {
                "siteId": {"in": "path", "type": "string", "required": true},
                "page": {"in": "query", "type": "int", "required": false},
                "limit": {"in": "query", "type": "int", "required": false}
            },
            "pagination": {
                "type": "page_header_total",
                "page_size": 2,
                "page_param": "page",
                "limit_param": "limit",
                "start_page": 1
            }
        }
    ]
}
