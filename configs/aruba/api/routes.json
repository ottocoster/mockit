{
    "routes": [
        { "method": "POST", "path": "/oauth2/authorize/central/api/login", "public": true, "file": "login.json" },
        { "method": "POST", "path": "/oauth2/authorize/central/api", "oauth_authorize": true },
        { "method": "POST", "path": "/oauth2/token", "oauth_token": true },
        {
            "method": "GET",
            "path": "/monitoring/v2/aps",
            "file": "aps.json",
            "params": {
                "next": {"in": "query", "type": "int", "required": false},
                "limit": {"in": "query", "type": "int", "required": false}
            },
            "pagination": {
                "type": "offset_items_total",
                "page_size": 2,
                "offset_param": "next",
                "limit_param": "limit",
                "items_key": "aps",
                "total_key": "total"
            }
        }
    ]
}
