{
    "routes": [
        {
            "method": "GET",
            "path": "/api/v1/organizations",
            "file": "organizations.json"
        },
        {
            "method": "GET",
            "path": "/api/v1/organizations/{organizationId}/devices",
            "file": "devices.json",
            "params": {
                "organizationId": {"in": "path", "type": "string", "required": true},
                "perPage": {"in": "query", "type": "int", "required": false}
            }
        }
    ]
}
