{
  "name": "mockit-web",
  "private": true,
  "description": "Mock'it running in the browser via Pyodide (WebAssembly)",
  "scripts": {
    "build": "python3 build.py",
    "serve": "python3 build.py && python3 -m http.server -d dist 8080"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "country-flag-emoji-polyfill": "^0.1.10",
    "pyodide": "^0.27.7"
  }
}
