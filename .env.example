# Supported device types you want to imitate, look at supported_devices_ssh.md
# DEVICE_TYPE=""

# Incase your device has different subfolders because of versioning. Look at Mikrotik_routeros as an example.
# DEVICE_VERSION=""

# SSH_USERNAME=""
# SSH_PASSWORD=""

# Adds a delay (in seconds) before responding to a command.
# DEVICE_DELAY=""

# Adds a delay (in seconds) before the server accepts an SSH connection.
# LOGIN_DELAY=""

# Defines the number of retries allowed for login attempts.
# LOGIN_RETRY=""

# Enable print debug logs (default is false)
# DEBUG_ENABLED=true

# Log the full file path in log output (e.g. /src/base_handler.py.141).
# When false, log only the module name (e.g. base_handler.141) for more
# compact logs. (default is true)
# LOG_FULL_PATH=false

# Enable SNMP V2 (default enabled)
# SNMP_V2_ENABLED=true

# SNMP community string (default public)
# SNMP_V2_COMMUNITY=""

# Enable SNMP V3 (default disabled)
# SNMP_V3_ENABLED=false

# SNMP_V3_USERNAME=""
# SNMP_V3_AUTH_TYPE=""
# SNMP_V3_AUTH_KEY=""
# SNMP_V3_PRIV_TYPE=""
# SNMP_V3_PRIV_KEY=""

# AI: enable AI support to respond on unknown commands. Works with any
# OpenAI-compatible provider (OpenAI, LM Studio, Ollama, ...).
# AI_SUPPORT=true
# AI_APIKEY=""

# Base URL of the OpenAI-compatible API. Leave empty for the default OpenAI
# endpoint, or point it at a local server:
#   - LM Studio: AI_URL="http://localhost:1234/v1"
#   - Ollama:    AI_URL="http://localhost:11434/v1"
# AI_URL=""

# Model name requested from the AI provider. For LM Studio/Ollama set it to a
# locally available model, e.g. "lmstudio-community/Meta-Llama-3.1-8B-Instruct".
# AI_MODEL="gpt-5.5"

# Store AI-generated outputs as <command>.txt template files, so future requests
# are served from those files instead of calling the AI (default false)
# AI_STORE_RESPONSES=false

# Terminal: custom prompts used for command outputs via AI.
# AI_TERMINAL_OUTPUT supports {device_type}, {device_version} and {command}
# placeholders. AI_TERMINAL_PROMPT is the system message.
#
# AI_TERMINAL_OUTPUT="Output for device type {device_type} and command {command}. Please give me the output of this command of the device type without any explanation. You have to reply with only one command output."
# AI_TERMINAL_PROMPT="You are a AI vendor assistant that returns output of network devices."

# SNMP: custom prompts used when generating the snmp.json MIB content.
# AI_SNMP_OUTPUT supports {device_type} and {device_version} placeholders.
# AI_SNMP_PROMPT is the system message.
# AI_SNMP_OUTPUT="Generate snmp json for {device_type} version {device_version}"
# AI_SNMP_PROMPT="You are a SNMP assistant."
# =============================================================================
# HTTP/REST API driver
# =============================================================================
# Auto-enabled when a driver ships configs/<driver>/api/routes.json.
# API_SERVER_ENABLED=true
# API_PORT=443

# Auth type: none | bearer | apikey | oauth2
# API_AUTH_TYPE=none

# Bearer token (API_AUTH_TYPE=bearer)
# API_TOKEN=""

# API key + header (API_AUTH_TYPE=apikey)
# API_KEY=""
# API_KEY_HEADER="X-API-KEY"

# OAuth2 client credentials (API_AUTH_TYPE=oauth2)
# API_OAUTH_CLIENT_ID=""
# API_OAUTH_CLIENT_SECRET=""
